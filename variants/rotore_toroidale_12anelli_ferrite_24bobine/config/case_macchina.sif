! Elmer FEM SIF: Macchina Elettromagnetica con 24 Bobine / Poli Alternati PN e NP
! Gabbia Sferica in Alluminio con traferro sottile

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "."
  Include Path ""
  Results Directory "results"
End

Simulation
  Max Output Level = 4
  Coordinate System = Cartesian 3D
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = Transient
  Steady State Max Iterations = 1
  Output Intervals(1) = 1
  Timestep Intervals(1) = 4
  Timestep Sizes(1) = 0.0025
End

Constants
  Permittivity of Vacuum = 8.8542e-12
  Permeability of Vacuum = 1.2566370614e-6
End

Equation 1
  Name = "MagnetoDynamicsEquation"
  Active Solvers(3) = 1 2 3
End

Solver 1
  Equation = "MGDynamics"
  Variable = "AV"
  Procedure = "MagnetoDynamics" "WhitneyAVSolver"

  Linear System Solver = "Iterative"
  Linear System Preconditioning = ILU0
  Linear System Max Iterations = 500
  Linear System Iterative Method = BiCGStabl
  BicGStabL Polynomial Degree = 2
  Linear System Convergence Tolerance = 1.0e-5
  Linear System Abort Not Converged = Logical False
End

Solver 2
  Equation = "MGDynamicsCalc"
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"

  Potential Variable = String "AV"
  Calculate Elemental Fields = Logical True
  Calculate Nodal Fields = Logical True
  Calculate Magnetic Flux Density = Logical True
  Calculate Current Density = Logical True
  Calculate Electric Field = Logical True

  Linear System Solver = "Iterative"
  Linear System Preconditioning = None
  Linear System Max Iterations = 200
  Linear System Iterative Method = BiCGStabl
  Linear System Convergence Tolerance = 1.0e-5
End

Solver 3
  Equation = "ResultOutput"
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = "macchina_fem"
  Output Format = "vtu"
  Vtu Format = Logical True
  Save Geometry Ids = Logical True
End

Material 1
  Name = "Air"
  Relative Permeability = 1.0
  Electric Conductivity = 0.0
End

Material 2
  Name = "AluminumCage"
  Relative Permeability = 1.0
  Electric Conductivity = 1.75e7
End

Material 3
  Name = "CopperCoilPN"
  Relative Permeability = 1.0
  Electric Conductivity = 5.8e7
End

Material 4
  Name = "CopperCoilNP"
  Relative Permeability = 1.0
  Electric Conductivity = 5.8e7
End

$ function j_pos(tx) {\
  s = sin(628.31853 * tx);\
  _j_pos = 1.0e6 * 0.5 * (s + abs(s));\
}

$ function j_neg(tx) {\
  s = sin(628.31853 * tx);\
  _j_neg = 1.0e6 * 0.5 * (s - abs(s));\
}

Body Force 1
  Name = "PN_Diode_Positive_Halfwave"
  Current Density 3 = Variable time
    Real MATC "j_pos(tx)"
End

Body Force 2
  Name = "NP_Diode_Negative_Halfwave"
  Current Density 3 = Variable time
    Real MATC "j_neg(tx)"
End

Body 1
  Target Bodies(1) = 1
  Name = "AirExterior"
  Equation = 1
  Material = 1
End

Body 2
  Target Bodies(1) = 2
  Name = "Aluminum"
  Equation = 1
  Material = 2
End

Body 3
  Target Bodies(1) = 3
  Name = "CoilPos"
  Equation = 1
  Material = 3
  Body Force = 1
End

Body 4
  Target Bodies(1) = 4
  Name = "CoilNeg"
  Equation = 1
  Material = 4
  Body Force = 2
End

Boundary Condition 1
  Target Boundaries(1) = 1
  Name = "FarField"
  AV {e} = Real 0.0
  AV = Real 0.0
End
